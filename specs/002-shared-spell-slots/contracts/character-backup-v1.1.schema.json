{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PathfinderCharacterBackupV1.1",
  "description": "Schema for Pathfinder character sheets with shared spell slots and documentation URLs.",
  "type": "object",
  "required": ["schemaVersion", "exportedAt", "character", "health", "resources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "level", "characterClass", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "level": { "type": "integer", "minimum": 1, "maximum": 20 },
        "characterClass": { "type": "string", "minLength": 1, "maxLength": 60 },
        "avatarDataUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "health": {
      "type": "object",
      "required": ["maxHp", "currentHp", "tempHp"],
      "additionalProperties": false,
      "properties": {
        "maxHp": { "type": "integer", "minimum": 1 },
        "currentHp": { "type": "integer", "minimum": 0 },
        "tempHp": { "type": "integer", "minimum": 0 }
      }
    },
    "spellSlots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["level", "max", "available"],
        "properties": {
          "level": { "type": "integer", "minimum": 1, "maximum": 9 },
          "max": { "type": "integer", "minimum": 0 },
          "available": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "usageMode", "description", "sortOrder"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "category": { "type": "string", "enum": ["spell", "feat_trait"] },
          "usageMode": { "type": "string", "enum": ["limited", "unlimited"] },
          "spellLevel": { "type": ["integer", "null"], "minimum": 0, "maximum": 9 },
          "url": { "type": "string", "maxLength": 500 },
          "maxUses": { "type": ["integer", "null"], "minimum": 1 },
          "availableUses": { "type": ["integer", "null"], "minimum": 0 },
          "description": { "type": "string", "maxLength": 4000 },
          "sortOrder": { "type": "integer" }
        }
      }
    }
  }
}
